# mdmail configuration. Copy to .env and edit. Never commit .env.
# Every variable also accepts a *_FILE variant pointing to a file (Docker secrets).
# Full reference: docs/configuration.md

# Fully qualified name of this server (MX target, EHLO name, web UI host).
MDMAIL_HOSTNAME=mail.example.com
# Comma-separated mail domains hosted here.
MDMAIL_DOMAINS=example.com

# TLS: "acme" (automatic Let's Encrypt via HTTP-01 on port 80) or "files".
MDMAIL_TLS_MODE=acme
MDMAIL_ACME_EMAIL=postmaster@example.com
# MDMAIL_ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory
# MDMAIL_TLS_CERT_FILE=/certs/live/mail.example.com/fullchain.pem
# MDMAIL_TLS_KEY_FILE=/certs/live/mail.example.com/privkey.pem

# Limits
MDMAIL_MAX_MESSAGE_BYTES=26214400
MDMAIL_MAX_RECIPIENTS=50
MDMAIL_SUBMIT_PER_HOUR=200

# Inbound policy
MDMAIL_DMARC_ENFORCE=true
MDMAIL_INBOUND_REQUIRE_TLS=false

# Outbound TLS: verify | encrypt | opportunistic
MDMAIL_OUTBOUND_TLS=encrypt

# DKIM selector (publish <selector>._domainkey.<domain>)
MDMAIL_DKIM_SELECTOR=mdmail

# MTA-STS policy served at https://mta-sts.<domain>/.well-known/mta-sts.txt
# none | testing | enforce
MDMAIL_MTASTS_MODE=testing

# Web sessions
MDMAIL_SESSION_TTL=12h
MDMAIL_SESSION_IDLE=30m

MDMAIL_LOG_LEVEL=info
